# Normalize line endings. Git stores LF in the repository; these rules keep the working tree
# consistent across Windows, macOS, and Linux, and silence the "LF will be replaced by CRLF"
# warnings that appear when committing generated files such as infra/arm/azuredeploy.json.

* text=auto eol=lf

# ── Text files: always LF ─────────────────────────────────────────────────────
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.sql       text eol=lf
*.kql       text eol=lf
*.bicep     text eol=lf
*.bicepparam text eol=lf
*.sh        text eol=lf
*.env.example text eol=lf

# PowerShell: LF in the repository, UTF-8 in the working tree.
*.ps1       text eol=lf working-tree-encoding=UTF-8
*.psm1      text eol=lf working-tree-encoding=UTF-8
*.psd1      text eol=lf working-tree-encoding=UTF-8

# Dotfiles and tooling configuration
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf
.dockerignore  text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf

# ── Binary files: never diffed, never normalized ──────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.exe       binary
*.dll       binary
*.pfx       binary
*.p12       binary

# Office documents used for decks and reports
*.pptx      binary
*.docx      binary
*.xlsx      binary

# Columnar data used by customer POC mode
*.parquet   binary
*.snappy    binary

# ── GitHub linguist ───────────────────────────────────────────────────────────
# Keep documentation out of the language statistics.
docs/**/*.md                    linguist-documentation
*.md                            linguist-detectable=false

# infra/arm/azuredeploy.json is compiled output, not hand-written source.
# Collapse it in pull request diffs; regenerate it with `az bicep build` instead of editing it.
infra/arm/azuredeploy.json      linguist-generated=true

# Lockfiles are generated; collapse them in diffs.
package-lock.json               linguist-generated=true
