# Azure Data Explorer connection (your existing FinOps Hub cluster)
ADX_CLUSTER_URI=https://your-finops-hub.region.kusto.windows.net
ADX_DATABASE=Hub
# Seconds a single ADX query may run before it is cancelled, client-side and on
# the cluster. Defaults to 30. Raise it if wide date ranges time out.
# ADX_QUERY_TIMEOUT_SECONDS=30

# Optional: override Azure auth (defaults to DefaultAzureCredential)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Azure AI Foundry / Azure OpenAI — powers chat, daily insights and AI insights.
# Auth is Entra ID (DefaultAzureCredential); there is no API key to store.
# You need the "Cognitive Services OpenAI User" role on the resource.
#
# Both endpoint surfaces are supported and detected automatically:
#   classic: https://<resource>.openai.azure.com          (or .cognitiveservices.azure.com)
#   v1:      https://<resource>.openai.azure.com/openai/v1
# The v1 form is what the Foundry portal shows, so it can be pasted as-is.
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=model-router

# Required when the Foundry resource lives in a DIFFERENT tenant from the one
# your default Azure login resolves to. Without it every call fails with
# "Token tenant ... does not match resource tenant", which looks like an RBAC
# problem but is not. Overrides AZURE_TENANT_ID for the Foundry call only.
# AZURE_OPENAI_TENANT_ID=

# Optional: pin the API version. Defaults to 2025-04-01-preview, which supports
# max_completion_tokens (required by reasoning models the router can select).
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: a non-reasoning deployment used for structured, fixed-schema tasks
# where a hidden chain of thought buys nothing. Measured on the same JSON
# extraction: gpt-4o 148 total tokens vs 579-1491 through the router. Left
# unset, those tasks use AZURE_OPENAI_DEPLOYMENT.
# AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o

# Azure Pricing MCP server URL (start with: cd mcp/azure-pricing-mcp && python -m azure_pricing_mcp --transport http --port 8080)
AZURE_PRICING_MCP_URL=http://localhost:8080

# Azure SKU Advisor API — backs the /sku-advisor view.
# Leave unset to fall back to a recommendations.json placed in the customer
# workspace, and then to the bundled sample. Start locally with:
#   cd ../Azure-SKU-Advisor && uvicorn azure_sku_advisor.api.app:app --port 8081
# SKU_ADVISOR_API_URL=http://localhost:8081
# SKU_ADVISOR_API_KEY=
# Analyze the real VM inventory instead of the advisor's bundled sample. The
# advisor must also run with SKU_ADVISOR_ALLOW_LIVE=true, or it refuses and the
# view degrades to the sample inventory (and labels it as such).
# SKU_ADVISOR_LIVE_USAGE=false
# Regions the estate runs in, comma-separated. Live discovery is filtered by
# region, and with none given the advisor falls back to its own pricing region
# list (eastus by default) — an estate outside it then reports zero workloads
# with no error at all. Set this whenever SKU_ADVISOR_LIVE_USAGE is on.
# SKU_ADVISOR_REGIONS=uksouth,swedencentral
# Guide rightsizing with a live 90-day P99 CPU/memory/IOPS busy-signal from
# Azure Monitor instead of spec-parity sizing alone. Requires the advisor to
# run with SKU_ADVISOR_ALLOW_LIVE=true and its Managed Identity to hold
# Reader/Monitoring Reader on the estate subscription; otherwise the advisor
# refuses the whole live request and the view retries with all live flags off.
# SKU_ADVISOR_LIVE_TELEMETRY=false

# Mock mode — set to "true" for frontend dev without ADX connection
NEXT_PUBLIC_USE_MOCK=false

# Dashboard defaults
NEXT_PUBLIC_DEFAULT_BUDGET=10000
NEXT_PUBLIC_DEFAULT_MONTHS=6
NEXT_PUBLIC_DEFAULT_DAYS=28

# Dashboard sign-in (users). Leave AUTH_ENABLED unset locally: the app then
# ignores the X-MS-CLIENT-PRINCIPAL header entirely and runs as a synthetic
# "Local Dev" Admin. In Azure this is injected by Bicep from enableEasyAuth —
# do not set it by hand there.
# AUTH_ENABLED=true
# AUTH_DEFAULT_ROLE=none
