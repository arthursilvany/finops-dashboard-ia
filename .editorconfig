# EditorConfig — consistent formatting across editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ── Web application (TypeScript, styles, config) ──────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html}]
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_size = 2

# ── Infrastructure as code ────────────────────────────────────────────────────
[*.{bicep,bicepparam}]
indent_size = 2

# ── PowerShell ────────────────────────────────────────────────────────────────
[*.{ps1,psm1,psd1}]
indent_size = 4

# ── Python ────────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 100

# ── Shell ─────────────────────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
# Trailing whitespace is significant in Markdown (two spaces force a line break),
# so it must not be trimmed automatically.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ── Generated and vendored files: leave them exactly as produced ──────────────
[{package-lock.json,infra/arm/azuredeploy.json}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
